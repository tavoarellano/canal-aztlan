<icecast>
    <location>Aguascalientes, México</location>
    <admin>canal.aztlan@example.com</admin>

    <limits>
        <clients>100</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- Contraseña con la que TU programa (BUTT) se conecta para transmitir -->
        <source-password>${SOURCE_PASSWORD}</source-password>
        <!-- Contraseña del panel de administración web -->
        <admin-user>admin</admin-user>
        <admin-password>${ADMIN_PASSWORD}</admin-password>
    </authentication>

    <hostname>${ICECAST_HOSTNAME}</hostname>

    <!-- Railway inyecta la variable PORT automáticamente -->
    <listen-socket>
        <port>${PORT}</port>
    </listen-socket>

    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <!-- Punto de montaje principal de Canal Aztlán -->
    <mount type="normal">
        <mount-name>/stream</mount-name>
        <stream-name>Canal Aztlán</stream-name>
        <stream-description>Radio independiente: lectura de libros, cultura y voz para México</stream-description>
        <genre>Cultura / Literatura</genre>
        <public>0</public>
    </mount>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/index.html"/>
    </paths>

    <logging>
        <accesslog>-</accesslog>
        <errorlog>-</errorlog>
        <loglevel>3</loglevel>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
